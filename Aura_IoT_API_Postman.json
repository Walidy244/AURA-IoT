{
  "info": {
    "name": "Aura IoT - LED & Sensor API",
    "description": "Collection of API tests for LED control and sensor monitoring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "LED Control",
      "item": [
        {
          "name": "Get Current LED Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://10.80.69.94:8000/api/led/current/",
              "protocol": "http",
              "host": ["10", "80", "69", "94"],
              "port": "8000",
              "path": ["api", "led", "current", ""]
            },
            "description": "Get the current state of the LED including color, brightness, and timer settings"
          }
        },
        {
          "name": "Toggle LED On/Off",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "http://10.80.69.94:8000/api/led/toggle/",
              "protocol": "http",
              "host": ["10", "80", "69", "94"],
              "port": "8000",
              "path": ["api", "led", "toggle", ""]
            },
            "description": "Toggle LED between on and off state"
          }
        },
