    {
      "name": "Sensor Data",
      "item": [
        {
          "name": "Get Latest Sensor Reading",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://10.80.69.94:8000/api/sensors/latest/",
              "protocol": "http",
              "host": ["10", "80", "69", "94"],
              "port": "8000",
              "path": ["api", "sensors", "latest", ""]
            },
            "description": "Get the most recent DHT11 sensor reading"
          }
        },
        {
          "name": "Get Sensor Averages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://10.80.69.94:8000/api/sensors/average/?limit=10",
              "protocol": "http",
              "host": ["10", "80", "69", "94"],
              "port": "8000",
              "path": ["api", "sensors", "average", ""],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Get average temperature and humidity for the last 10 readings"
          }
        },
        {
          "name": "List All Sensor Readings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://10.80.69.94:8000/api/sensors/?limit=10&ordering=-timestamp",
              "protocol": "http",
              "host": ["10", "80", "69", "94"],
              "port": "8000",
              "path": ["api", "sensors", ""],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "ordering",
                  "value": "-timestamp"
                }
              ]
            },
            "description": "Get list of sensor readings with pagination and ordering"
          }
        },
        {
          "name": "Record New Sensor Reading",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"temperature\": 24.5, \"humidity\": 65.2}"
            },
            "url": {
              "raw": "http://10.80.69.94:8000/api/sensors/record/",
              "protocol": "http",
              "host": ["10", "80", "69", "94"],
              "port": "8000",
              "path": ["api", "sensors", "record", ""]
            },
            "description": "Record a new DHT11 sensor reading from ESP32 or device"
          }
        },
        {
          "name": "Record Sensor Data - Temperature 22",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"temperature\": 22.0, \"humidity\": 60.0}"
            },
            "url": {
              "raw": "http://10.80.69.94:8000/api/sensors/record/",
              "protocol": "http",
              "host": ["10", "80", "69", "94"],
              "port": "8000",
              "path": ["api", "sensors", "record", ""]
            },
            "description": "Record sensor reading with 22°C temperature"
          }
        }
      ]
