        {
          "name": "Set LED Timer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"turn_on_at\": \"08:00\", \"turn_off_at\": \"18:00\", \"color\": \"white\"}"
